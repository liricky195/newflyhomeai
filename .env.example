# ── Database ─────────────────────────────────────────────────────────────────
# DATABASE_URL — path to SQLite file, e.g. ./data/flyhome.db
# In production use Turso (hosted SQLite) or a Railway/Fly.io persistent volume.
# Vercel ephemeral filesystem is incompatible with SQLite persistence — see README.
DATABASE_URL=./data/flyhome.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# NEXTAUTH_URL — full deployment URL, e.g. https://flyhome.ai
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET — generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# ── OAuth ─────────────────────────────────────────────────────────────────────
# Google OAuth credentials — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Flight data ───────────────────────────────────────────────────────────────
# AERODATABOX_API_KEY — from RapidAPI AeroDataBox FIDS subscription
AERODATABOX_API_KEY=

# ── Duffel ────────────────────────────────────────────────────────────────────
# DUFFEL_API_KEY — use duffel_test_... for sandbox, duffel_live_... for production
DUFFEL_API_KEY=
# DUFFEL_WEBHOOK_SECRET — from Duffel dashboard webhook settings
DUFFEL_WEBHOOK_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
# All from Stripe dashboard (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for subscription tiers
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTIMATE=

# ── Push notifications (VAPID) ────────────────────────────────────────────────
# Generate keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT — contact URL or mailto: address
VAPID_SUBJECT=mailto:ops@flyhome.ai

# ── Email (Resend) ────────────────────────────────────────────────────────────
# RESEND_API_KEY — from Resend dashboard (API Keys)
RESEND_API_KEY=
# RESEND_FROM_ADDRESS — verified sender address, e.g. alerts@flyhome.ai
RESEND_FROM_ADDRESS=alerts@flyhome.ai
